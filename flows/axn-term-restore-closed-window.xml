<?xml version="1.0" encoding="UTF-8"?>
<flows>
  <flow name="axn-term - closed extra window is not restored"
        description="Verify that an extra window created and closed before the app stops is not reopened.">
    <tags>
      <tag>axn-term</tag>
    </tags>
    <setup>
      <env>
        <var name="AXN_TERM_BINARY" value="target/release/axn-term" />
        <var name="AXN_TERM_TEST_VARIANT" value="single" />
      </env>
    </setup>
    <steps>
      <step adapter="axn-term" action="prepare" description="Create temp state with one window" >
        <assert that="contains" value="state dir prepared"  description="The test harness is ready"/>
      </step>

      <step adapter="axn-term" action="start" description="Launch axn-term" >
        <assert that="contains" value="app started"  description="The app started"/>
      </step>

      <step adapter="axn-term" action="runDevin" description="Run the devin session" >
        <assert that="contains" value="devin running"  description="devin is running"/>
      </step>

      <step adapter="axn-term" action="createWindow" description="Open an extra window" >
        <assert that="contains" value="window created"  description="Extra window was created"/>
      </step>

      <step adapter="axn-term" action="closeWindow" description="Close the extra window before stopping" >
        <assert that="contains" value="window closed"  description="Extra window was closed"/>
      </step>

      <step adapter="axn-term" action="close" description="Close axn-term so main window state is persisted" >
        <assert that="contains" value="app closed"  description="The app closed and saved state"/>
      </step>

      <step adapter="axn-term" action="reopen" description="Reopen and verify the closed extra window did not come back" >
        <assert that="contains" value="gray-party"  description="Only the main window is restored"/>
        <assert that="contains" value="windows: 1"  description="Only the main window is restored"/>
        <assert that="contains" value="single window"  description="Only the main window is restored"/>
      </step>
    </steps>
  </flow>
</flows>
