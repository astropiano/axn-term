<?xml version="1.0" encoding="UTF-8"?>
<flows>
  <flow name="axn-term - closed extra window is not restored"
        description="Verify that an extra window created and closed before the app stops is not reopened.">
    <tags>
      <tag>axn-term</tag>
    </tags>
    <setup>
      <env>
        <var name="AXN_TERM_BINARY" value="target/release/axn-term" />
        <var name="AXN_TERM_TEST_VARIANT" value="single" />
      </env>
    </setup>
    <steps>
      <script adapter="axn-term" action="prepare" description="Create temp state with one window" />
      <assertions description="The test harness is ready">
        <assert that="contains" value="state dir prepared" />
      </assertions>

      <script adapter="axn-term" action="start" description="Launch axn-term" />
      <assertions description="The app started">
        <assert that="contains" value="app started" />
      </assertions>

      <script adapter="axn-term" action="runDevin" description="Run the devin session" />
      <assertions description="devin is running">
        <assert that="contains" value="devin running" />
      </assertions>

      <script adapter="axn-term" action="createWindow" description="Open an extra window" />
      <assertions description="Extra window was created">
        <assert that="contains" value="window created" />
      </assertions>

      <script adapter="axn-term" action="closeWindow" description="Close the extra window before stopping" />
      <assertions description="Extra window was closed">
        <assert that="contains" value="window closed" />
      </assertions>

      <script adapter="axn-term" action="close" description="Close axn-term so main window state is persisted" />
      <assertions description="The app closed and saved state">
        <assert that="contains" value="app closed" />
      </assertions>

      <script adapter="axn-term" action="reopen" description="Reopen and verify the closed extra window did not come back" />
      <assertions description="Only the main window is restored">
        <assert that="contains" value="gray-party" />
        <assert that="contains" value="windows: 1" />
        <assert that="contains" value="single window" />
      </assertions>
    </steps>
  </flow>
</flows>
