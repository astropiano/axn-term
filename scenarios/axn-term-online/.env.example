# Local overrides for the axn-term-online scenario. Copy to .env (gitignored)
# next to compose.yaml; compose reads it automatically.

# Container-engine socket the gateway uses to spawn per-user session hosts.
# Default: /var/run/docker.sock (Docker). For rootless podman, enable the
# user socket once and point at it:
#   systemctl --user enable --now podman.socket
DOCKER_SOCK=/run/user/1000/podman/podman.sock
