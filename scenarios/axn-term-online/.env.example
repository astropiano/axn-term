# Local overrides for the axn-term-online scenario. Copy to .env (gitignored)
# next to compose.yaml; compose reads it automatically.

# Container-engine socket the gateway uses to spawn per-user session hosts.
# Default: /var/run/docker.sock (Docker). For rootless podman, enable the
# user socket once and point at it:
#   systemctl --user enable --now podman.socket
DOCKER_SOCK=/run/user/1000/podman/podman.sock

# --- Machine identity (LAN serving) -----------------------------------------
# This host's mDNS name / LAN IP — phones and other machines on the LAN reach
# the stack at https://<ip>:18092 (Android can't resolve .local names).
# AXN_LAN_IP=192.168.1.10
# AXN_LAN_NAME=my-laptop.local
#
# The one address every client can reach — Keycloak's login page and token
# issuer live under it (/auth). The LAN IP for home use, or the tailnet URL
# when phones should also sign in away from home:
# AXN_PUBLIC_URL=https://192.168.1.10:18092
#
# Optional tailnet endpoint (tailscale-serve.sh prints it):
# AXN_TAILNET_URL=https://my-laptop.tail1234.ts.net
#
# Certificates: ./make-dev-certs.sh (local CA + server cert for the names above).

# --- Local ramphastos checkout ----------------------------------------------
# Default: published Ramphastos.* NuGet + ramphastos-client npm packages.
# RAMPHASTOS_LOCAL_DEPS=1 builds .NET/vite against the sibling checkout —
# AXN_LIBS_ROOT must point at the dir containing it (dev/libraries).
# RAMPHASTOS_LOCAL_DEPS=1
# AXN_LIBS_ROOT=/path/to/dev/libraries

# --- Session-host data root --------------------------------------------------
# Host directory bind-mounted into every per-user session host. Unset → /tmp
# (ephemeral). Point at a roomy drive if the root fs is tight.
# DATA_MOUNT=/mnt/extended/axn-term
