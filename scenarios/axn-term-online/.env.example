# Local overrides for the axn-term-online scenario. Copy to .env (gitignored)
# next to compose.yaml; compose reads it automatically.

# Container-engine socket the gateway uses to spawn per-user session hosts.
# Default: /var/run/docker.sock (Docker). For rootless podman, enable the
# user socket once and point at it:
#   systemctl --user enable --now podman.socket
DOCKER_SOCK=/run/user/1000/podman/podman.sock

# --- Machine identity (LAN serving) -----------------------------------------
# This host's mDNS name / LAN IP — used for https://<name>.local:<port> URLs
# that phones and other machines on the LAN can reach (cert: Caddy internal CA).
# AXN_LAN_IP=192.168.1.10
# AXN_LAN_NAME=my-laptop.local
# AXN_KEYCLOAK_URL=https://my-laptop.local:18093
# AXN_GATEWAY_URL=wss://my-laptop.local:18094
# VITE_RAMPHASTOS_URL=wss://my-laptop.local:18094/ramphastos

# --- Session-host data root --------------------------------------------------
# Host directory bind-mounted into every per-user session host. Unset → /tmp
# (ephemeral). Point at a roomy drive if the root fs is tight.
# DATA_MOUNT=/mnt/extended/axn-term
