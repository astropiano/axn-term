{
  "id": "axn-term",
  "realm": "axn-term",
  "displayName": "Axn Term",
  "enabled": true,
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xFrameOptions": "SAMEORIGIN"
  },
  "registrationAllowed": false,
  "loginWithEmailAllowed": false,
  "rememberMe": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "clients": [
    {
      "clientId": "axn-term",
      "name": "Axn Term",
      "description": "Web shell frontend",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [
        "http://axn-term.localhost:18092/*",
        "http://axn-term.localhost:18091/*",
        "http://axn-term.localhost:8092/*",
        "http://localhost:5175/*",
        "http://localhost:5176/*",
        "https://axn-term.192.168.1.202.nip.io:18092/*",
        "https://192.168.1.202:18092/*",
        "https://axn-term.localhost:18092/*",
        "https://axn-term.localhost:18091/*",
        "https://axn-term.localhost:8092/*",
        "https://localhost:5175/*",
        "https://localhost:5176/*",
        "https://axn-term-host-1.local:18092/*",
        "https://axn-term.local:18092/*"
      ],
      "webOrigins": [
        "http://axn-term.localhost:18092",
        "http://axn-term.localhost:18091",
        "http://axn-term.localhost:8092",
        "http://localhost:5175",
        "http://localhost:5176",
        "https://axn-term.192.168.1.202.nip.io:18092",
        "https://192.168.1.202:18092",
        "https://axn-term.localhost:18092",
        "https://axn-term.localhost:18091",
        "https://axn-term.localhost:8092",
        "https://localhost:5175",
        "https://localhost:5176",
        "https://axn-term-host-1.local:18092",
        "https://axn-term.local:18092"
      ],
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "use.refresh.tokens": "true",
        "pkce.code.challenge.method": "S256"
      },
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    },
    {
      "clientId": "axn-term-desktop",
      "name": "Axn Term Desktop",
      "description": "Desktop app \u2014 device-flow sign-in for remote publishing",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "redirectUris": [],
      "webOrigins": [],
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "use.refresh.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "true",
        "access.token.lifespan": "3600"
      },
      "access": {
        "view": true,
        "configure": true,
        "manage": true
      }
    },
    {
      "clientId": "axn-term-mobile",
      "name": "Axn Term Mobile",
      "description": "Mobile app \u2014 device-flow sign-in for the remote viewer",
      "enabled": true,
      "redirectUris": [],
      "webOrigins": [],
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "publicClient": true,
      "frontchannelLogout": true,
      "protocol": "openid-connect",
      "attributes": {
        "use.refresh.tokens": "true",
        "oauth2.device.authorization.grant.enabled": "true",
        "access.token.lifespan": "900"
      },
      "optionalClientScopes": [
        "offline_access"
      ],
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "email": "admin@axn-term.local",
      "firstName": "Admin",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "attributes": {},
      "realmRoles": [
        "offline_access"
      ]
    },
    {
      "username": "demo",
      "enabled": true,
      "email": "demo@axn-term.local",
      "firstName": "Demo",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "changeme",
          "temporary": true
        }
      ],
      "attributes": {
        "region": "Europe/Zurich"
      },
      "realmRoles": [
        "user",
        "admin",
        "offline_access"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Regular user role"
      },
      {
        "name": "admin",
        "description": "Administrator role"
      }
    ]
  },
  "defaultRoles": [
    "user",
    "offline_access"
  ],
  "defaultSignatureAlgorithm": "RS256"
}
