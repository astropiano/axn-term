{
  // Type-checks the libs' tests and stories, which the app's tsconfig never
  // reaches (it only follows imports from src). Vitest strips types without
  // checking them, so CI runs this as its own step (`pnpm typecheck`).
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Tests run under Node 22 (vitest), not the app's ES2020 webview target.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": {
      "monaco-editor/esm/*": ["./node_modules/monaco-editor/esm/*"],
      "@axn-term/session-backend": ["../../libs/session-backend/src/index.ts"],
      "@axn-term/session-backend/tauri": ["../../libs/session-backend/src/tauri.ts"],
      "@axn-term/session-backend/remote": ["../../libs/session-backend/src/remote.ts"],
      "@axn-term/shell-ui": ["../../libs/shell-ui/src/index.ts"],
      "@axn-term/plugin-sdk": ["../../libs/plugin-sdk/src/index.ts"],
      // Storybook is installed for apps/desktop only; the libs' stories
      // resolve it from here, like Storybook itself does.
      "@storybook/react-vite": ["./node_modules/@storybook/react-vite/dist/index.d.ts"]
    }
  },
  "include": ["src", "../../libs/*/src/**/*.ts", "../../libs/*/src/**/*.tsx"]
}
