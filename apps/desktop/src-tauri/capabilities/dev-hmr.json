{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "dev-hmr",
  "description": "axn-term-hmr only (enabled by tauri.term-hmr.conf.json, never by the shipped tauri.conf.json): the session windows' grants for pages served by the spawned vite dev server, for runs where that origin is not the app's own frontendDist (e.g. `tauri dev -c src-tauri/tauri.term-hmr.conf.json`). Permissions mirror `default` (tests/window_capabilities.rs enforces it).",
  "local": false,
  "windows": [
    "main",
    "w-*"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:5914/*"
    ]
  },
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "fs:default",
    "fs:scope-home",
    "fs:allow-home-read-recursive",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:allow-write-text-file",
      "deny": [
        { "path": "$HOME/.ssh" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.gnupg" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.profile" },
        { "path": "$HOME/.bashrc" },
        { "path": "$HOME/.bash_profile" },
        { "path": "$HOME/.bash_login" },
        { "path": "$HOME/.bash_logout" },
        { "path": "$HOME/.zshenv" },
        { "path": "$HOME/.zshrc" },
        { "path": "$HOME/.zprofile" },
        { "path": "$HOME/.zlogin" },
        { "path": "$HOME/.zlogout" },
        { "path": "$HOME/.config/fish" },
        { "path": "$HOME/.config/fish/**" },
        { "path": "$HOME/.config/autostart" },
        { "path": "$HOME/.config/autostart/**" },
        { "path": "$HOME/.config/systemd" },
        { "path": "$HOME/.config/systemd/**" },
        { "path": "$HOME/Library/LaunchAgents" },
        { "path": "$HOME/Library/LaunchAgents/**" }
      ]
    },
    "fs:allow-exists",
    "fs:allow-read-dir",
    "fs:allow-watch",
    "fs:allow-unwatch",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-mkdir",
      "deny": [
        { "path": "$HOME/.ssh" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.gnupg" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.profile" },
        { "path": "$HOME/.bashrc" },
        { "path": "$HOME/.bash_profile" },
        { "path": "$HOME/.bash_login" },
        { "path": "$HOME/.bash_logout" },
        { "path": "$HOME/.zshenv" },
        { "path": "$HOME/.zshrc" },
        { "path": "$HOME/.zprofile" },
        { "path": "$HOME/.zlogin" },
        { "path": "$HOME/.zlogout" },
        { "path": "$HOME/.config/fish" },
        { "path": "$HOME/.config/fish/**" },
        { "path": "$HOME/.config/autostart" },
        { "path": "$HOME/.config/autostart/**" },
        { "path": "$HOME/.config/systemd" },
        { "path": "$HOME/.config/systemd/**" },
        { "path": "$HOME/Library/LaunchAgents" },
        { "path": "$HOME/Library/LaunchAgents/**" }
      ]
    },
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-destroy"
  ]
}
