{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for main and secondary application windows and the macOS Preferences window (settings), which renders the same settings UI",
  "windows": [
    "main",
    "w-*",
    "settings",
    "dev-settings"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "opener:allow-open-path",
    "fs:default",
    "fs:scope-home",
    "fs:allow-read-text-file",
    {
      "identifier": "fs:allow-write-text-file",
      "deny": [
        { "path": "$HOME/.ssh" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.gnupg" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.profile" },
        { "path": "$HOME/.bashrc" },
        { "path": "$HOME/.bash_profile" },
        { "path": "$HOME/.bash_login" },
        { "path": "$HOME/.bash_logout" },
        { "path": "$HOME/.zshenv" },
        { "path": "$HOME/.zshrc" },
        { "path": "$HOME/.zprofile" },
        { "path": "$HOME/.zlogin" },
        { "path": "$HOME/.zlogout" },
        { "path": "$HOME/.config/fish" },
        { "path": "$HOME/.config/fish/**" },
        { "path": "$HOME/.config/autostart" },
        { "path": "$HOME/.config/autostart/**" },
        { "path": "$HOME/.config/systemd" },
        { "path": "$HOME/.config/systemd/**" },
        { "path": "$HOME/Library/LaunchAgents" },
        { "path": "$HOME/Library/LaunchAgents/**" }
      ]
    },
    "fs:allow-watch",
    "fs:allow-unwatch",
    "dialog:allow-open",
    "dialog:allow-save",
    {
      "identifier": "fs:allow-mkdir",
      "deny": [
        { "path": "$HOME/.ssh" },
        { "path": "$HOME/.ssh/**" },
        { "path": "$HOME/.gnupg" },
        { "path": "$HOME/.gnupg/**" },
        { "path": "$HOME/.profile" },
        { "path": "$HOME/.bashrc" },
        { "path": "$HOME/.bash_profile" },
        { "path": "$HOME/.bash_login" },
        { "path": "$HOME/.bash_logout" },
        { "path": "$HOME/.zshenv" },
        { "path": "$HOME/.zshrc" },
        { "path": "$HOME/.zprofile" },
        { "path": "$HOME/.zlogin" },
        { "path": "$HOME/.zlogout" },
        { "path": "$HOME/.config/fish" },
        { "path": "$HOME/.config/fish/**" },
        { "path": "$HOME/.config/autostart" },
        { "path": "$HOME/.config/autostart/**" },
        { "path": "$HOME/.config/systemd" },
        { "path": "$HOME/.config/systemd/**" },
        { "path": "$HOME/Library/LaunchAgents" },
        { "path": "$HOME/Library/LaunchAgents/**" }
      ]
    },
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-destroy"
  ]
}
