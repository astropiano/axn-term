<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>AxnTerm.Gateway</RootNamespace>
    <AssemblyName>AxnTerm.Gateway</AssemblyName>
    <PackageId>AxnTerm.Gateway</PackageId>
    <Version>0.1.0</Version>
    <Authors>axn-term</Authors>
    <Company>axn-term</Company>
    <Description>WebSocket gateway for axn-term sessions</Description>
    <GenerateOpenApiDocuments>false</GenerateOpenApiDocuments>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
    <PackageReference Include="Docker.DotNet" Version="3.125.15" />
  </ItemGroup>

  <PropertyGroup>
    <!-- net10 only — Ramphastos.Server targets net10. -->
    <TargetFrameworks>net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Condition="'$(RamphastosLocalDeps)' != 'true'" Include="Ramphastos.Server" Version="0.2.0-alpha.1" />
    <!-- RAMPHASTOS_LOCAL_DEPS=1 → sibling checkout (../ramphastos next to
         axn-term, /ramphastos in container builds); see Directory.Build.props. -->
    <ProjectReference Condition="'$(RamphastosLocalDeps)' == 'true'" Include="$(RamphastosLocalDepsRoot)ramphastos\src\Ramphastos.Server\Ramphastos.Server.csproj" />
  </ItemGroup>

</Project>
