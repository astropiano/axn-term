<Project>
  <!--
    Build configuration for the axn-term repo.
    Applies to all .NET projects in this repo (apps/gateway, apps/session-host).
  -->

  <!-- .NET version for this repo. Change here to upgrade all projects. -->
  <PropertyGroup>
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
    <!-- Workaround: SDK 10.0.111 ships without net10 prune package data -->
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
  </PropertyGroup>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Local development: set env var RAMPHASTOS_LOCAL_DEPS=1 to build
         against the sibling ramphastos checkout (../ramphastos next to
         axn-term) instead of the published NuGet packages — mirrors the
         mechanism in the ramphastos repo itself. Override the sibling
         root with the RamphastosLocalDepsRoot env var or /p: property. -->
    <RamphastosLocalDeps Condition="'$(RAMPHASTOS_LOCAL_DEPS)' != ''">true</RamphastosLocalDeps>
    <RamphastosLocalDepsRoot Condition="'$(RamphastosLocalDepsRoot)' == ''">$(MSBuildThisFileDirectory)..\</RamphastosLocalDepsRoot>
  </PropertyGroup>

</Project>
