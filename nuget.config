<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Sibling libraries are not yet on a feed; sibling-repo package output.
         Layout: <repo> checked out side by side (astropiano layout).
         In container builds the sibling trees are copied to /<repo>
         (same relative depth from the build root). -->
    <add key="local-rt" value="../reflectiontools/src/packages" />
    <add key="local-ts" value="../totalserializer/src/packages-local" />
  </packageSources>
</configuration>
