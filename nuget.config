<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Sibling libraries are not yet on a feed; sibling-repo package output.
         Layout per axn-dev setup: dev/libraries/<repo> checked out side by side.
         In container builds the sibling trees are copied to /libraries/<repo>
         (same relative depth from the build root). -->
    <add key="local-rt" value="../../libraries/reflectiontools/src/packages" />
    <add key="local-ts" value="../../libraries/totalserializer/packages-local" />
  </packageSources>
</configuration>
